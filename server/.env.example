# MongoDB connection URI for the application database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# Replace with a long, randomly generated secret; never use this placeholder
JWT_SECRET=replace_with_a_long_random_secret

# Qdrant Cloud cluster URL and API key
QDRANT_URL=https://<your-qdrant-cluster-host>
QDRANT_API_KEY=replace_with_qdrant_api_key

# Exact browser origin allowed by the backend CORS policy
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
PORT=5000
